# Build trees. `build/` is the one the README uses; the glob catches the
# side-by-side ones you get from configuring with a different compiler or
# sanitizer.
build/
build-*/
cmake-build-*/

# Personal presets that sit alongside the checked-in CMakePresets.json.
CMakeUserPresets.json

# Generated by CMAKE_EXPORT_COMPILE_COMMANDS, for clangd and friends.
compile_commands.json
.cache/

# CMake droppings if someone configures in the source tree by mistake.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Editors and tooling
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db
